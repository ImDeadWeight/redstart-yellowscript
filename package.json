{
  "name": "redstart-yellowscript",
  "displayName": "Redstart Yellowscript",
  "description": "Coding agent for a local Redstart Nest — zero-config discovery, Redstart login, workspace-aware tools.",
  "version": "0.0.1",
  "publisher": "redstart",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Machine Learning"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "redstartYellowscript.connect",
        "title": "Connect to Nest",
        "category": "Yellowscript"
      },
      {
        "command": "redstartYellowscript.disconnect",
        "title": "Disconnect",
        "category": "Yellowscript"
      },
      {
        "command": "redstartYellowscript.signIn",
        "title": "Sign In to Nest",
        "category": "Yellowscript"
      },
      {
        "command": "redstartYellowscript.signOut",
        "title": "Sign Out (forget credential)",
        "category": "Yellowscript"
      },
      {
        "command": "redstartYellowscript.showStatus",
        "title": "Show Connection Status",
        "category": "Yellowscript"
      }
    ],
    "configuration": {
      "title": "Redstart Yellowscript",
      "properties": {
        "redstartYellowscript.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Explicit Nest gateway URL (e.g. `http://192.168.1.20:19080`). When set, discovery is skipped entirely. Leave empty to find the Nest automatically via its beacon."
        },
        "redstartYellowscript.discovery.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Scan the local network for a running Redstart Nest on connect."
        },
        "redstartYellowscript.discovery.timeoutMs": {
          "type": "number",
          "default": 400,
          "minimum": 50,
          "maximum": 5000,
          "description": "Per-host timeout for the beacon probe. Raise this on a slow or congested network."
        },
        "redstartYellowscript.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Try to reconnect to the last known Nest when a window opens."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run test",
    "package": "npm run check && npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
