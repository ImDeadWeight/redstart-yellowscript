{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // esbuild produces the bundle; tsc's only job here is typechecking. That
    // frees us to import with explicit `.ts` extensions, which is what Node's
    // native type stripping needs to run `node --test` over the sources with
    // no build step and no test-runner dependency.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // The vendored agent-core is plain ESM. allowJs lets it be imported;
    // checkJs stays off (it is checked upstream), and src/agent/agent-core.ts
    // gives it types.
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"]
  },
  // The webview entry is excluded and typechecked by tsconfig.webview.json
  // instead — it is a browser context and needs a different lib/types set.
  // Everything else it imports (markdown.ts, chat/protocol.ts) is
  // environment-agnostic and is checked by both projects.
  "include": ["src/**/*.ts", "esbuild.mjs"],
  "exclude": ["src/webview/**/*.ts"]
}
